                    <div id="current-message-preview" style="background: #121927; border: 1px solid rgba(255,255,255,0.05); border-radius: var(--radius-md); padding: 1rem; min-height: 120px; font-size: 0.9rem; white-space: pre-wrap; max-height: 200px; overflow-y: auto;">
