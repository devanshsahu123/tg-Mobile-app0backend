    <!-- Toast Notifications Container -->
    <div class="toast-container" id="toast-container"></div>

    <!-- Page Scripts -->
    <script>
        // Tab switching
        function switchTab(tabName) {
            document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
            document.querySelectorAll('.tab-panel').forEach(panel => panel.classList.remove('active'));

            const activeBtn = document.querySelector(`.tab-btn[onclick="switchTab('${tabName}')"]`);
            const activePanel = document.getElementById(`panel-${tabName}`);

            if (activeBtn) activeBtn.classList.add('active');
            if (activePanel) activePanel.classList.add('active');

            if (tabName === 'database') {
                loadLeads();
            }
        }

        // Global states for importing
        let parsedHeaders = [];
        let parsedData = [];
        let fileLoaded = false;
        let globalCleanedLeads = []; // holds the cleaned, split leads array

        // Setup drop-zone events
        const dropZone = document.getElementById('drop-zone');
        const fileInput = document.getElementById('file-input');

        dropZone.addEventListener('dragover', (e) => {
            e.preventDefault();
            dropZone.classList.add('drag-active');
        });

        dropZone.addEventListener('dragleave', () => {
            dropZone.classList.remove('drag-active');
        });

        dropZone.addEventListener('drop', (e) => {
            e.preventDefault();
            dropZone.classList.remove('drag-active');
            if (e.dataTransfer.files.length > 0) {
                handleFile(e.dataTransfer.files[0]);
            }
        });

        fileInput.addEventListener('change', (e) => {
            if (e.target.files.length > 0) {
                handleFile(e.target.files[0]);
            }
        });

        function handleFile(file) {
            const name = file.name.toLowerCase();
            if (name.endsWith('.csv')) {
                handleCSVFile(file);
            } else if (name.endsWith('.xlsx') || name.endsWith('.xls')) {
                handleExcelFile(file);
            } else {
                showToast('Please select a valid CSV or Excel file.', 'danger');
            }
        }

        // Parse Excel file
        function handleExcelFile(file) {
            if (typeof XLSX === 'undefined') {
                showToast('Excel parser library (SheetJS) is not loaded.', 'danger');
                return;
            }

            const uploadIcon = document.querySelector('.upload-icon');
            uploadIcon.className = 'fa-solid fa-spinner fa-spin upload-icon';

            const reader = new FileReader();
            reader.onload = function (e) {
                try {
                    const data = new Uint8Array(e.target.result);
                    const workbook = XLSX.read(data, { type: 'array' });
                    
                    if (workbook.SheetNames.length === 0) {
                        throw new Error("Excel file contains no sheets.");
                    }
                    
                    const firstSheetName = workbook.SheetNames[0];
                    const worksheet = workbook.Sheets[firstSheetName];
                    const rawRows = XLSX.utils.sheet_to_json(worksheet, { header: 1, defval: "" });
                    
                    if (rawRows.length === 0) {
                        throw new Error("The Excel sheet is empty.");
                    }

                    const headers = rawRows[0].map((h, i) => String(h || "").trim() || `Column ${i + 1}`);
                    const rows = rawRows.slice(1).map(row => {
                        const obj = {};
                        headers.forEach((header, i) => {
                            obj[header] = row[i] !== undefined ? String(row[i]).trim() : "";
                        });
                        return obj;
                    });

                    uploadIcon.className = 'fa-solid fa-cloud-arrow-up upload-icon';

                    parsedData = rows;
                    parsedHeaders = headers;
                    fileLoaded = true;

                    // Update Labels
                    document.getElementById('file-name-label').textContent = file.name;
                    document.getElementById('file-details-label').textContent = 
                        `${rows.length} rows found • ${Math.round(file.size / 1024)} KB`;

                    // Hide drag zone, show mapping
                    dropZone.style.display = 'none';
                    document.getElementById('no-file-alert').style.display = 'none';
                    document.getElementById('file-info-container').style.display = 'block';
                    document.getElementById('mapping-section').style.display = 'block';

                    populateMappingDropdowns();
                    autoMapColumns();
                    updateMappingPreview();
                    showToast('Excel parsed successfully. Ready for mapping.', 'success');
                } catch (err) {
                    uploadIcon.className = 'fa-solid fa-cloud-arrow-up upload-icon';
                    showToast('Excel Parsing Failed: ' + err.message, 'danger');
                }
            };
            reader.onerror = function () {
                uploadIcon.className = 'fa-solid fa-cloud-arrow-up upload-icon';
                showToast('Error reading Excel file.', 'danger');
            };
            reader.readAsArrayBuffer(file);
        }

        // Parse CSV file
        function handleCSVFile(file) {
            const uploadIcon = document.querySelector('.upload-icon');
            uploadIcon.className = 'fa-solid fa-spinner fa-spin upload-icon';

            Papa.parse(file, {
                header: true,
                skipEmptyLines: 'greedy',
                complete: function (results) {
                    uploadIcon.className = 'fa-solid fa-cloud-arrow-up upload-icon';
                    
                    if (results.errors.length > 0 && results.data.length === 0) {
                        showToast('Error reading CSV file.', 'danger');
                        return;
                    }

                    parsedData = results.data;
                    parsedHeaders = results.meta.fields || [];
                    fileLoaded = true;

                    // Update Labels
                    document.getElementById('file-name-label').textContent = file.name;
                    document.getElementById('file-details-label').textContent = 
                        `${results.data.length} rows found • ${Math.round(file.size / 1024)} KB`;

                    // Hide drag zone, show mapping
                    dropZone.style.display = 'none';
                    document.getElementById('no-file-alert').style.display = 'none';
                    document.getElementById('file-info-container').style.display = 'block';
                    document.getElementById('mapping-section').style.display = 'block';

                    populateMappingDropdowns();
                    autoMapColumns();
                    updateMappingPreview();
                    showToast('CSV parsed successfully. Ready for mapping.', 'success');
                },
                error: function (err) {
                    uploadIcon.className = 'fa-solid fa-cloud-arrow-up upload-icon';
                    showToast('CSV Parsing Failed: ' + err.message, 'danger');
                }
            });
        }

        function populateMappingDropdowns() {
            const dropdowns = ['map-business', 'map-client', 'map-mobile', 'map-email', 'map-city'];
            dropdowns.forEach(id => {
                const select = document.getElementById(id);
                select.innerHTML = '<option value="">-- Ignore --</option>';
                
                parsedHeaders.forEach(header => {
                    const opt = document.createElement('option');
                    opt.value = header;
                    opt.textContent = header;
                    select.appendChild(opt);
                });
            });
        }

        function autoMapColumns() {
            const mappings = {
                'map-business': [/business/i, /company/i, /firm/i, /organization/i, /org/i, /vendor/i],
                'map-client': [/client/i, /customer/i, /name/i, /contact/i, /person/i, /owner/i],
                'map-mobile': [/phone/i, /mobile/i, /number/i, /tel/i, /cell/i, /contact/i],
                'map-email': [/email/i, /mail/i, /e-mail/i],
                'map-city': [/city/i, /town/i, /location/i, /place/i, /address/i]
            };

            for (const [selectId, patterns] of Object.entries(mappings)) {
                const select = document.getElementById(selectId);
                const match = parsedHeaders.find(header => {
                    return patterns.some(pattern => pattern.test(header));
                });
                if (match) {
                    select.value = match;
                }
            }
        }

        function getCurrentMapping() {
            return {
                businessName: document.getElementById('map-business').value,
                clientName: document.getElementById('map-client').value,
                mobileNumber: document.getElementById('map-mobile').value,
                email: document.getElementById('map-email').value,
                City: document.getElementById('map-city').value
            };
        }

        // Contact Number Cleaning & Extraction
        function cleanAndExtractPhoneNumbers(rawPhone) {
            if (!rawPhone) return [];
            // Split by common separators: comma, slash, semicolon, vertical bar, "and", "or"
            const parts = String(rawPhone).split(/,|\/|;|\||\band\b/i);
            const validNumbers = [];
            
            parts.forEach(part => {
                let cleaned = part.trim();
                if (!cleaned) return;
                
                // 1. If it's a numeric representation (possibly scientific or decimal from Excel)
                // Remove spaces and parentheses first to see if it is numeric
                let rawDigitsAndSigns = cleaned.replace(/[\s\(\)]/g, '');
                
                // If it is a valid number (e.g. 9876543210.0 or 9.18273E+11)
                if (!isNaN(rawDigitsAndSigns) && rawDigitsAndSigns !== '') {
                    // Let JS convert it to a standard integer string
                    let parsedNum = Number(rawDigitsAndSigns);
                    cleaned = String(Math.floor(parsedNum));
                } else {
                    // If it contains letters/characters, clean standard symbols
                    cleaned = cleaned.replace(/[\s\-\(\)\.]/g, '');
                }

                // 2. Remove Indian country code prefix (+91 or 91)
                if (cleaned.startsWith('+91')) {
                    cleaned = cleaned.substring(3);
                } else if (cleaned.startsWith('91') && cleaned.length === 12) {
                    cleaned = cleaned.substring(2);
                } else if (cleaned.startsWith('0') && cleaned.length === 11) {
                    cleaned = cleaned.substring(1);
                }
                
                // 3. Keep only numeric characters
                cleaned = cleaned.replace(/\D/g, '');
                
                // 4. Validate if it is a 10-digit number
                if (cleaned.length === 10) {
                    validNumbers.push(cleaned);
                } else if (cleaned.length > 10) {
                    // If it is longer than 10 digits (e.g., country code not stripped above), take the last 10 digits
                    const last10 = cleaned.substring(cleaned.length - 10);
                    validNumbers.push(last10);
                }
            });
            
            return validNumbers;
        }

        // Apply mapping, split & clean phone numbers, update preview table
        function updateMappingPreview() {
            const mapping = getCurrentMapping();
            const previewTbody = document.getElementById('preview-tbody');
            const summaryDiv = document.getElementById('data-cleaning-summary');
            const summaryText = document.getElementById('cleaning-summary-text');
            const btnSubmit = document.getElementById('btn-import-submit');
            const btnExport = document.getElementById('btn-export-excel');
            
            previewTbody.innerHTML = '';
            globalCleanedLeads = [];

            if (!mapping.businessName || !mapping.mobileNumber) {
                btnSubmit.disabled = true;
                btnExport.disabled = true;
                summaryDiv.style.display = 'none';
                document.getElementById('preview-total-rows').textContent = '0 records total';
                return;
            }

            let splitCount = 0;
            let skippedCount = 0;
            const finalLeads = [];

            parsedData.forEach(row => {
                const business = row[mapping.businessName] ? String(row[mapping.businessName]).trim() : '';
                if (!business) {
                    skippedCount++;
                    return;
                }

                const rawPhone = row[mapping.mobileNumber] ? String(row[mapping.mobileNumber]).trim() : '';
                const phones = cleanAndExtractPhoneNumbers(rawPhone);

                if (phones.length === 0) {
                    skippedCount++;
                    return;
                }

                if (phones.length > 1) {
                    splitCount += (phones.length - 1);
                }

                phones.forEach(phone => {
                    finalLeads.push({
                        businessName: business,
                        clientName: mapping.clientName ? String(row[mapping.clientName] || '').trim() : '',
                        mobileNumber: phone,
                        email: mapping.email ? String(row[mapping.email] || '').trim() : '',
                        City: mapping.City ? String(row[mapping.City] || '').trim() : ''
                    });
                });
            });

            globalCleanedLeads = finalLeads;
            document.getElementById('preview-total-rows').textContent = `${globalCleanedLeads.length} clean records`;

            // Update Cleaning Summary Alert
            summaryDiv.className = 'alert alert-success';
            summaryText.innerHTML = `<strong>Data Cleaned:</strong> Parsed <strong>${parsedData.length}</strong> raw rows. Generated <strong>${globalCleanedLeads.length}</strong> valid leads (split <strong>${splitCount}</strong> multiple contact numbers, skipped <strong>${skippedCount}</strong> invalid records without proper phone numbers).`;
            summaryDiv.style.display = 'flex';

            // Toggle action buttons
            if (globalCleanedLeads.length > 0) {
                btnSubmit.disabled = false;
                btnExport.disabled = false;
            } else {
                btnSubmit.disabled = true;
                btnExport.disabled = true;
            }

            // Preview first 5 rows
            const sampleRows = globalCleanedLeads.slice(0, 5);
            sampleRows.forEach(lead => {
                const tr = document.createElement('tr');
                const tds = [
                    lead.businessName,
                    lead.clientName || '-',
                    lead.mobileNumber,
                    lead.email || '-',
                    lead.City || '-'
                ];
                tds.forEach(val => {
                    const td = document.createElement('td');
                    td.textContent = val;
                    tr.appendChild(td);
                });
                previewTbody.appendChild(tr);
            });
        }

        // Export clean separated leads back to Excel XLSX
        function exportCleanedExcel() {
            if (globalCleanedLeads.length === 0) {
                showToast('No clean data to download.', 'danger');
                return;
            }

            try {
                // Map to proper titles for Excel headers
                const excelData = globalCleanedLeads.map(lead => ({
                    "Business Name": lead.businessName,
                    "Client Name": lead.clientName,
                    "Mobile Number": lead.mobileNumber,
                    "Email Address": lead.email,
                    "City": lead.City
                }));

                const wb = XLSX.utils.book_new();
                const ws = XLSX.utils.json_to_sheet(excelData);
                XLSX.utils.book_append_sheet(wb, ws, "Cleaned Leads");
                XLSX.writeFile(wb, "cleaned_contact_leads.xlsx");
                showToast('Cleaned Excel downloaded successfully!', 'success');
            } catch (err) {
                console.error(err);
                showToast('Failed to download Excel file: ' + err.message, 'danger');
            }
        }

        // Reset CSV Wizard back to upload state
        function resetImportWizard() {
            parsedHeaders = [];
            parsedData = [];
            fileLoaded = false;
            fileInput.value = '';
            globalCleanedLeads = [];

            dropZone.style.display = 'block';
            document.getElementById('no-file-alert').style.display = 'flex';
            document.getElementById('file-info-container').style.display = 'none';
            document.getElementById('mapping-section').style.display = 'none';
            document.getElementById('import-progress').style.display = 'none';
            document.getElementById('btn-import-submit').disabled = false;
            document.getElementById('btn-export-excel').disabled = true;
            document.getElementById('data-cleaning-summary').style.display = 'none';
        }

        // Submit the mapped data to MongoDB
        async function submitImport() {
            if (globalCleanedLeads.length === 0) {
                showToast('No valid records found to import.', 'danger');
                return;
            }

            const progressContainer = document.getElementById('import-progress');
            const progressFill = document.getElementById('progress-fill');
            const progressPercent = document.getElementById('progress-percent');
            const progressStatusMsg = document.getElementById('progress-status-msg');
            const btnSubmit = document.getElementById('btn-import-submit');

            progressContainer.style.display = 'block';
            btnSubmit.disabled = true;

            progressFill.style.width = '20%';
            progressPercent.textContent = '20%';
            progressStatusMsg.textContent = 'Packaging database payload...';

            try {
                await new Promise(r => setTimeout(r, 400));
                
                progressFill.style.width = '50%';
                progressPercent.textContent = '50%';
                progressStatusMsg.textContent = 'Transmitting leads to server...';

                const response = await fetch('/contact-number/import', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ leads: globalCleanedLeads })
                });

                const result = await response.json();

                if (response.ok && result.success) {
                    progressFill.style.width = '100%';
                    progressPercent.textContent = '100%';
                    progressStatusMsg.textContent = result.message || 'Import complete.';

                    if (result.duplicates && result.duplicates > 0) {
                        showToast(result.message, 'warning');
                    } else {
                        showToast(result.message || `Successfully imported ${result.count} leads!`, 'success');
                    }
                    
                    setTimeout(() => {
                        resetImportWizard();
                        switchTab('database');
                    }, 2500);
                } else {
                    throw new Error(result.message || 'Import failed');
                }
            } catch (error) {
                console.error('Import error:', error);
                progressContainer.style.display = 'none';
                btnSubmit.disabled = false;
                showToast('Import Failed: ' + error.message, 'danger');
            }
        }

        // Global states for Database View
        let dbCurrentPage = 1;
        let dbPageSize = 1000;
        let dbSearchQuery = '';
        let dbSearchTimeout = null;

        // Fetch leads from DB API
        async function loadLeads() {
            const tbody = document.getElementById('db-leads-tbody');
            tbody.innerHTML = `
                <tr>
                    <td colspan="8" style="text-align: center; padding: 3rem;">
                        <i class="fa-solid fa-circle-notch fa-spin" style="font-size: 2rem; color: var(--primary); margin-bottom: 0.5rem;"></i>
                        <p style="color: var(--text-muted);">Fetching leads archive...</p>
                    </td>
                </tr>
            `;

            const selectAllCheckbox = document.getElementById('select-all-leads');
            if(selectAllCheckbox) selectAllCheckbox.checked = false;
            updateComposeButton();

            try {
                const sentFilter = document.getElementById('db-sent-filter').value;
                const url = `/contact-number/leads?page=${dbCurrentPage}&limit=${dbPageSize}&search=${encodeURIComponent(dbSearchQuery)}&sentFilter=${sentFilter}`;
                const response = await fetch(url);
                const result = await response.json();

                if (!response.ok || !result.success) {
                    throw new Error(result.message || 'Failed to fetch leads');
                }

                const leads = result.data || [];
                const pagination = result.pagination || { totalItems: 0, totalPages: 1, currentPage: 1 };

                dbCurrentPage = pagination.currentPage;
                document.getElementById('page-num-display').textContent = `${pagination.currentPage} / ${pagination.totalPages || 1}`;
                
                document.getElementById('btn-page-prev').disabled = dbCurrentPage <= 1;
                document.getElementById('btn-page-next').disabled = dbCurrentPage >= pagination.totalPages;

                const startItem = pagination.totalItems === 0 ? 0 : (dbCurrentPage - 1) * dbPageSize + 1;
                const endItem = Math.min(dbCurrentPage * dbPageSize, pagination.totalItems);
                document.getElementById('db-stats-text').textContent = 
                    `Showing ${startItem} to ${endItem} of ${pagination.totalItems} leads`;

                if (leads.length === 0) {
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="8">
                                <div class="empty-state">
                                    <i class="fa-solid fa-folder-open"></i>
                                    <h3>No Leads Found</h3>
                                    <p>The leads database is currently empty. Try uploading a CSV or Excel file.</p>
                                </div>
                            </td>
                        </tr>
                    `;
                    return;
                }

                tbody.innerHTML = '';
                leads.forEach(lead => {
                    const tr = document.createElement('tr');
                    
                    const cbTd = document.createElement('td');
                    cbTd.innerHTML = `<input type="checkbox" class="lead-checkbox" value="${lead._id}" data-business="${lead.businessName}" data-client="${lead.clientName}" data-mobile="${lead.mobileNumber}" data-city="${lead.City}" onchange="updateComposeButton()">`;
                    tr.appendChild(cbTd);

                    const cells = [
                        lead.businessName || '-',
                        lead.clientName || '-',
                        lead.mobileNumber || '-',
                        lead.email || '-',
                        lead.City || '-'
                    ];

                    cells.forEach(val => {
                        const td = document.createElement('td');
                        td.textContent = val;
                        tr.appendChild(td);
                    });

                    const dateTd = document.createElement('td');
                    dateTd.textContent = lead.createdAt ? new Date(lead.createdAt).toLocaleDateString() : '-';
                    tr.appendChild(dateTd);

                    const sentTd = document.createElement('td');
                    const count = lead.messageSentCount || 0;
                    sentTd.innerHTML = count > 0 ? `<span style="background: rgba(16, 185, 129, 0.2); color: #6ee7b7; padding: 0.2rem 0.5rem; border-radius: 99px; font-size: 0.75rem; font-weight: 600;">${count}</span>` : `<span style="color: var(--text-muted);">-</span>`;
                    tr.appendChild(sentTd);

                    tbody.appendChild(tr);
                });

            } catch (error) {
                console.error('Load error:', error);
                tbody.innerHTML = `
                    <tr>
                        <td colspan="8" style="text-align: center; padding: 3rem; color: var(--danger);">
                            <i class="fa-solid fa-triangle-exclamation" style="font-size: 2rem; margin-bottom: 0.5rem;"></i>
                            <p>Failed to load database. (${error.message})</p>
                        </td>
                    </tr>
                `;
            }
        }

        function changePage(direction) {
            dbCurrentPage += direction;
            loadLeads();
        }

        function handleSearchInput(e) {
            clearTimeout(dbSearchTimeout);
            dbSearchQuery = e.target.value;
            dbSearchTimeout = setTimeout(() => {
                dbCurrentPage = 1;
                loadLeads();
            }, 300);
        }

        function handleSentFilterChange() {
            dbCurrentPage = 1;
            loadLeads();
        }

        async function confirmClearDatabase() {
            if (!confirm('Are you absolutely sure you want to delete ALL leads from the contact collection? This action is permanent.')) {
                return;
            }

            try {
                const response = await fetch('/contact-number/leads/clear', {
                    method: 'DELETE'
                });
                const result = await response.json();

                if (response.ok && result.success) {
                    showToast(result.message, 'success');
                    dbCurrentPage = 1;
                    loadLeads();
                } else {
                    throw new Error(result.message || 'Wipe failed');
                }
            } catch (error) {
                showToast('Failed to clear database: ' + error.message, 'danger');
            }
        }

        async function downloadDatabaseExcel() {
            try {
                const btn = document.getElementById('btn-download-db-excel');
                const origHtml = btn.innerHTML;
                btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Downloading...';
                btn.disabled = true;

                const sentFilter = document.getElementById('db-sent-filter').value;
                const search = encodeURIComponent(dbSearchQuery);
                
                // Fetch up to 100,000 matches with the current search query and filters
                const url = `/contact-number/leads?page=1&limit=100000&search=${search}&sentFilter=${sentFilter}`;
                const response = await fetch(url);
                const result = await response.json();

                btn.innerHTML = origHtml;
                btn.disabled = false;

                if (!response.ok || !result.success) {
                    throw new Error(result.message || 'Failed to fetch database leads');
                }

                const leads = result.data || [];
                if (leads.length === 0) {
                    showToast('No leads found matching current filter/search to export.', 'warning');
                    return;
                }

                const excelData = leads.map(lead => ({
                    "Business Name": lead.businessName,
                    "Client Name": lead.clientName,
                    "Mobile Number": lead.mobileNumber,
                    "Email Address": lead.email,
                    "City": lead.City,
                    "Sent Messages Count": lead.messageSentCount || 0,
                    "Import Date": lead.createdAt ? new Date(lead.createdAt).toLocaleDateString() : ''
                }));

                const wb = XLSX.utils.book_new();
                const ws = XLSX.utils.json_to_sheet(excelData);
                XLSX.utils.book_append_sheet(wb, ws, "Database Leads");
                XLSX.writeFile(wb, "database_contact_leads.xlsx");
                showToast(`Successfully downloaded ${leads.length} leads!`, 'success');
            } catch (err) {
                console.error(err);
                showToast('Failed to download Excel file: ' + err.message, 'danger');
            }
        }

        function toggleSelectAll(checkbox) {
            document.querySelectorAll('.lead-checkbox').forEach(cb => cb.checked = checkbox.checked);
            updateComposeButton();
        }

        function updateComposeButton() {
            const checkedCount = document.querySelectorAll('.lead-checkbox:checked').length;
            const btnCompose = document.getElementById('btn-compose');
            
            if (checkedCount > 0) {
                btnCompose.disabled = false;
                btnCompose.innerHTML = `<i class="fa-brands fa-whatsapp"></i> Compose Message (${checkedCount})`;
            } else {
                btnCompose.disabled = true;
                btnCompose.innerHTML = `<i class="fa-brands fa-whatsapp"></i> Compose Message`;
            }
        }

        const messageTemplates = <%- JSON.stringify(templates || []) %>;

        function applySelectedTemplate(templateId) {
            const bodyInput = document.getElementById('message-body');
            
            if (!templateId) {
                bodyInput.value = '';
                return;
            }

            const template = messageTemplates.find(t => t.id === templateId);
            if (template) {
                bodyInput.value = template.body || '';
            }
        }

        function openComposeModal() {
            document.getElementById('compose-modal').style.display = 'flex';
        }

        function closeComposeModal() {
            document.getElementById('compose-modal').style.display = 'none';
            const templateSelect = document.getElementById('template-select');
            if (templateSelect) templateSelect.value = '';
            document.getElementById('message-body').value = '';
        }

        // WhatsApp Broadcast Queue Variables
        let broadcastQueue = [];
        let currentQueueIndex = 0;
        let broadcastTemplate = '';
        let queueSuccessCount = 0;
        let queueSkippedCount = 0;

        function closeQueueModal() {
            document.getElementById('queue-modal').style.display = 'none';
            // Reload database to update counts
            loadLeads();
        }

        // Start broadcasting queue modal
        function startBroadcastQueue() {
            const selectedCheckboxes = Array.from(document.querySelectorAll('.lead-checkbox:checked'));
            const bodyText = document.getElementById('message-body').value.trim();

            if (selectedCheckboxes.length === 0) {
                showToast('Please select at least one contact.', 'danger');
                return;
            }
            if (!bodyText) {
                showToast('Please write a message template.', 'danger');
                return;
            }

            broadcastTemplate = bodyText;
            broadcastQueue = selectedCheckboxes.map(cb => ({
                id: cb.value,
                businessName: cb.getAttribute('data-business') || '',
                clientName: cb.getAttribute('data-client') || '',
                mobileNumber: cb.getAttribute('data-mobile') || '',
                City: cb.getAttribute('data-city') || '',
                status: 'pending' // pending, sent, skipped
            }));

            currentQueueIndex = 0;
            queueSuccessCount = 0;
            queueSkippedCount = 0;

            // Close compose modal
            closeComposeModal();

            // Open queue modal
            document.getElementById('queue-modal').style.display = 'flex';

            renderQueueList();
            showCurrentQueueLead();
        }

        // Render queue list inside scroll area
        function renderQueueList() {
            const container = document.getElementById('queue-items-list');
            container.innerHTML = '';

            broadcastQueue.forEach((item, idx) => {
                const div = document.createElement('div');
                div.className = `queue-item ${idx === currentQueueIndex ? 'active' : ''} ${item.status}`;
                
                let iconHtml = '<i class="fa-regular fa-clock" style="color: var(--text-muted);"></i>';
                if (item.status === 'sent') {
                    iconHtml = '<i class="fa-solid fa-circle-check" style="color: var(--success);"></i>';
                } else if (item.status === 'skipped') {
                    iconHtml = '<i class="fa-solid fa-circle-minus" style="color: var(--text-muted);"></i>';
                } else if (idx === currentQueueIndex) {
                    iconHtml = '<i class="fa-solid fa-play" style="color: var(--primary);"></i>';
                }

                div.innerHTML = `
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        ${iconHtml}
                        <span>${item.businessName || 'Business'} (${item.mobileNumber})</span>
                    </div>
                    <span style="text-transform: capitalize; font-size: 0.75rem;">${item.status}</span>
                `;
                container.appendChild(div);
            });
        }

        // Load current lead variables into card
        function showCurrentQueueLead() {
            if (currentQueueIndex >= broadcastQueue.length) {
                // Queue finished!
                document.getElementById('current-business-name').textContent = 'Broadcast Complete!';
                document.getElementById('current-client-name').textContent = '';
                document.getElementById('current-mobile-number').textContent = '';
                document.getElementById('current-city-label').textContent = '';
                document.getElementById('current-message-preview').innerHTML = '<span style="color: var(--success); font-weight: bold;">You have successfully finished the broadcast queue!</span>';
                document.getElementById('btn-send-whatsapp-trigger').disabled = true;
                
                showToast(`Broadcast queue finished! Sent: ${queueSuccessCount}, Skipped: ${queueSkippedCount}`, 'success');
                return;
            }

            const current = broadcastQueue[currentQueueIndex];
            
            document.getElementById('current-business-name').textContent = current.businessName || 'Business Name';
            document.getElementById('current-client-name').textContent = current.clientName ? `Contact: ${current.clientName}` : 'No Client Name';
            document.getElementById('current-mobile-number').textContent = `+91 ${current.mobileNumber}`;
            document.getElementById('current-city-label').textContent = current.City || 'No City';

            // Replace variables
            let msgText = broadcastTemplate
                .replace(/{{businessName}}/g, current.businessName || "")
                .replace(/{{clientName}}/g, current.clientName || "")
                .replace(/{{City}}/g, current.City || "");

            document.getElementById('current-message-preview').textContent = msgText;
            document.getElementById('btn-send-whatsapp-trigger').disabled = false;

            // Update Progress Counts
            document.getElementById('queue-progress-count').textContent = `${currentQueueIndex + 1} / ${broadcastQueue.length}`;
            document.getElementById('queue-success-count').textContent = queueSuccessCount;
            document.getElementById('queue-skipped-count').textContent = queueSkippedCount;

            const pct = Math.round((currentQueueIndex / broadcastQueue.length) * 100);
            document.getElementById('queue-progress-bar').style.width = `${pct}%`;
        }

        // Skip current item
        function skipCurrentQueueItem() {
            if (currentQueueIndex >= broadcastQueue.length) return;
            
            broadcastQueue[currentQueueIndex].status = 'skipped';
            queueSkippedCount++;
            currentQueueIndex++;
            
            renderQueueList();
            showCurrentQueueLead();
        }

        // Trigger WhatsApp Redirect & DB Sent Count update
        async function triggerWhatsAppSend() {
            if (currentQueueIndex >= broadcastQueue.length) return;
            
            const current = broadcastQueue[currentQueueIndex];
            let msgText = broadcastTemplate
                .replace(/{{businessName}}/g, current.businessName || "")
                .replace(/{{clientName}}/g, current.clientName || "")
                .replace(/{{City}}/g, current.City || "");

            // Encode parameters
            const encodedPhone = '91' + current.mobileNumber;
            const encodedText = encodeURIComponent(msgText);

            // Open WhatsApp Web Link in new tab
            const waUrl = `https://api.whatsapp.com/send?phone=${encodedPhone}&text=${encodedText}`;
            window.open(waUrl, '_blank');

            // Send AJAX to server to increment messageSentCount
            try {
                const response = await fetch('/contact-number/leads/sent', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ leadIds: [current.id] })
                });
                
                if (response.ok) {
                    broadcastQueue[currentQueueIndex].status = 'sent';
                    queueSuccessCount++;
                } else {
                    console.error('Failed to increment sent count on database');
                    // We still mark as sent to keep queue moving
                    broadcastQueue[currentQueueIndex].status = 'sent';
                    queueSuccessCount++;
                }
            } catch (err) {
                console.error(err);
                broadcastQueue[currentQueueIndex].status = 'sent';
                queueSuccessCount++;
            }

            // Move to next contact
            currentQueueIndex++;
            renderQueueList();
            showCurrentQueueLead();
        }

        // Toast Helper
        function showToast(message, type = 'primary') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = `toast ${type}`;
            
            let icon = 'fa-circle-info';
            if (type === 'success') icon = 'fa-circle-check';
            if (type === 'danger') icon = 'fa-triangle-exclamation';
            if (type === 'warning') icon = 'fa-circle-exclamation';

            toast.innerHTML = `
                <i class="fa-solid ${icon}"></i>
                <span>${message}</span>
            `;
            container.appendChild(toast);

            setTimeout(() => {
                toast.style.opacity = '0';
                toast.style.transform = 'translateY(-20px)';
                toast.style.transition = 'all 0.3s ease';
                setTimeout(() => toast.remove(), 300);
            }, 4000);
        }
    </script>
</body>

</html>
