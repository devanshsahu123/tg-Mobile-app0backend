<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WhatsApp Admin Dashboard</title>
    <meta name="description" content="Admin panel to manage, approve and reject WhatsApp group submissions.">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #25d366;
            --primary-hover: #128c7e;
            --primary-light: #e8fdf1;
            --bg-main: #f1f5f9;
            --bg-card: #ffffff;
            --text-main: #1e293b;
            --text-muted: #64748b;
            --border: #e2e8f0;
            --success: #10b981;
            --danger: #ef4444;
            --warning: #f59e0b;
            --info: #3b82f6;
            --deleted: #6b21a8;
            --deleted-light: #f5f3ff;
            --deleted-border: #c4b5fd;
            --shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
            --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
            --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
            background-color: var(--bg-main);
            color: var(--text-main);
            line-height: 1.5;
            min-height: 100vh;
        }

        .layout { max-width: 1400px; margin: 0 auto; padding: 2rem; }

        /* ── Header ── */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
            background: var(--bg-card);
            padding: 1.25rem 2rem;
            border-radius: 1rem;
            box-shadow: var(--shadow-md);
        }
        .header-brand { display: flex; align-items: center; gap: 0.75rem; }
        .header-brand .logo {
            width: 40px; height: 40px;
            background: linear-gradient(135deg, #25d366, #128c7e);
            border-radius: 0.625rem;
            display: flex; align-items: center; justify-content: center;
        }
        .header-brand .logo svg { color: white; }
        .header-title h1 { font-size: 1.25rem; font-weight: 700; letter-spacing: -0.025em; }
        .header-title p { color: var(--text-muted); font-size: 0.8125rem; }
        .header-actions { display: flex; align-items: center; gap: 0.75rem; }

        /* ── Buttons ── */
        .btn {
            display: inline-flex; align-items: center; gap: 0.4rem;
            padding: 0.5rem 1rem;
            font-size: 0.8125rem; font-weight: 600;
            border-radius: 0.5rem;
            cursor: pointer;
            transition: all 0.18s cubic-bezier(0.4, 0, 0.2, 1);
            border: 1px solid transparent;
            text-decoration: none;
            white-space: nowrap;
        }
        .btn:disabled { opacity: 0.45; cursor: not-allowed; }
        .btn-primary  { background: var(--primary); color: #fff; }
        .btn-primary:hover:not(:disabled)  { background: var(--primary-hover); transform: translateY(-1px); box-shadow: 0 4px 12px rgba(37,211,102,.35); }
        .btn-outline  { background: #fff; border-color: var(--border); color: var(--text-main); }
        .btn-outline:hover:not(:disabled)  { background: var(--bg-main); border-color: var(--text-muted); }
        .btn-success  { background: var(--success); color: #fff; }
        .btn-success:hover:not(:disabled)  { background: #059669; transform: translateY(-1px); }
        .btn-danger   { background: var(--danger); color: #fff; }
        .btn-danger:hover:not(:disabled)   { background: #dc2626; transform: translateY(-1px); }
        .btn-warning  { background: var(--warning); color: #fff; }
        .btn-warning:hover:not(:disabled)  { background: #d97706; transform: translateY(-1px); }
        .btn-ghost    { background: transparent; color: var(--text-muted); border-color: transparent; }
        .btn-ghost:hover:not(:disabled)    { background: var(--bg-main); color: var(--text-main); }
        .btn-delete-forever {
            background: #450a0a; color: #fca5a5;
            border: 1px solid #7f1d1d;
        }
        .btn-delete-forever:hover:not(:disabled) {
            background: #991b1b; color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(153,27,27,.5);
        }
        .btn-sm { padding: 0.375rem 0.75rem; font-size: 0.75rem; }

        /* ── View Toggle ── */
        .view-toggle {
            display: flex; background: var(--bg-main); border-radius: 0.5rem; padding: 3px; gap: 2px;
        }
        .view-btn {
            padding: 0.375rem 0.625rem; border-radius: 0.375rem; cursor: pointer;
            border: none; background: transparent; color: var(--text-muted);
            transition: all 0.15s;
        }
        .view-btn.active { background: #fff; color: var(--primary); box-shadow: var(--shadow); }

        /* ── Nav Tabs ── */
        .nav-container {
            background: var(--bg-card);
            padding: 0.375rem; border-radius: 0.75rem;
            box-shadow: var(--shadow);
            margin-bottom: 1.25rem;
            display: flex; gap: 0.375rem;
        }
        .nav-tab {
            flex: 1; padding: 0.625rem 1rem;
            text-align: center; border-radius: 0.5rem;
            cursor: pointer; font-weight: 600; font-size: 0.8125rem;
            color: var(--text-muted);
            transition: all 0.2s;
            border: none; background: transparent;
            display: flex; align-items: center; justify-content: center; gap: 0.4rem;
        }
        .nav-tab:hover  { color: var(--text-main); background: var(--bg-main); }
        .nav-tab.active { background: var(--primary); color: white; box-shadow: 0 2px 8px rgba(37,211,102,.3); }
        .badge {
            background: rgba(0,0,0,0.12);
            padding: 0.1rem 0.5rem;
            border-radius: 9999px; font-size: 0.7rem; font-weight: 700;
        }
        .nav-tab.active .badge { background: rgba(255,255,255,0.25); }

        /* ── Bulk Action Bar ── */
        .bulk-bar {
            display: none;
            align-items: center; gap: 0.75rem;
            background: linear-gradient(135deg, #25d366, #128c7e);
            color: white;
            padding: 0.875rem 1.5rem;
            border-radius: 0.75rem;
            margin-bottom: 1.25rem;
            box-shadow: 0 4px 16px rgba(37,211,102,.35);
            animation: slideDown 0.2s ease;
        }
        .bulk-bar.visible { display: flex; }
        @keyframes slideDown {
            from { opacity: 0; transform: translateY(-8px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        .bulk-bar .selected-label { font-weight: 600; font-size: 0.875rem; margin-right: auto; }
        .bulk-btn {
            display: inline-flex; align-items: center; gap: 0.35rem;
            padding: 0.4rem 0.875rem;
            font-size: 0.8125rem; font-weight: 600;
            border-radius: 0.5rem; cursor: pointer; border: none;
            transition: all 0.15s;
        }
        .bulk-btn-approve { background: rgba(16,185,129,0.9); color: #fff; }
        .bulk-btn-approve:hover { background: #059669; }
        .bulk-btn-reject  { background: rgba(239,68,68,0.9);  color: #fff; }
        .bulk-btn-reject:hover  { background: #dc2626; }
        .bulk-btn-pend    { background: rgba(245,158,11,0.9); color: #fff; }
        .bulk-btn-pend:hover    { background: #d97706; }
        .bulk-btn-clear   { background: rgba(255,255,255,0.15); color: #fff; }
        .bulk-btn-clear:hover   { background: rgba(255,255,255,0.25); }
        .bulk-btn-delete-forever { background: #450a0a; color: #fca5a5; border: 1px solid rgba(252,165,165,0.3); }
        .bulk-btn-delete-forever:hover { background: #991b1b; color: #fff; box-shadow: 0 2px 8px rgba(153,27,27,.6); }

        /* ── Toolbar ── */
        .toolbar {
            display: flex; align-items: center; gap: 1rem;
            margin-bottom: 1rem;
        }
        .toolbar .left { display: flex; align-items: center; gap: 0.75rem; flex: 1; }
        .select-all-wrap {
            display: flex; align-items: center; gap: 0.5rem;
            font-size: 0.8125rem; font-weight: 600; color: var(--text-muted);
            cursor: pointer; user-select: none;
        }
        .select-all-wrap input[type="checkbox"] { width: 16px; height: 16px; cursor: pointer; accent-color: var(--primary); }
        .count-label { font-size: 0.8125rem; color: var(--text-muted); }

        /* ── Card Grid ── */
        .card-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 1.25rem;
        }
        .card {
            background: var(--bg-card);
            border-radius: 1rem;
            border: 1px solid var(--border);
            overflow: hidden;
            transition: all 0.25s ease;
            display: flex; flex-direction: column;
            position: relative;
        }
        .card:hover { transform: translateY(-3px); box-shadow: var(--shadow-lg); border-color: #bbf7d0; }
        .card.selected { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(37,211,102,.15); }

        .card-checkbox-wrap {
            position: absolute; top: 0.75rem; right: 0.75rem; z-index: 10;
        }
        .card-checkbox-wrap input[type="checkbox"] {
            width: 18px; height: 18px; cursor: pointer; accent-color: var(--primary);
        }

        .card-image-wrapper { position: relative; height: 160px; background: #f1f5f9; flex-shrink: 0; }
        .card-image { width: 100%; height: 100%; object-fit: cover; }
        .card-category {
            position: absolute; top: 0.75rem; left: 0.75rem;
            background: rgba(0,0,0,0.55); backdrop-filter: blur(4px);
            color: white; padding: 0.2rem 0.6rem;
            border-radius: 0.375rem; font-size: 0.7rem; font-weight: 700; text-transform: uppercase;
        }
        .card-body { padding: 1.125rem; flex-grow: 1; }
        .card-title {
            font-size: 1rem; font-weight: 700; margin-bottom: 0.375rem;
            display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden;
        }
        .card-description {
            font-size: 0.8125rem; color: var(--text-muted); margin-bottom: 0.875rem;
            display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
            min-height: 2.4rem;
        }
        .card-meta {
            display: flex; gap: 1rem; font-size: 0.7rem; color: var(--text-muted); margin-bottom: 0.875rem;
        }
        .meta-item { display: flex; align-items: center; gap: 0.25rem; }
        .card-link {
            display: flex; align-items: center; justify-content: center; gap: 0.35rem;
            padding: 0.5rem; width: 100%; text-decoration: none;
            font-size: 0.75rem; font-weight: 600; color: var(--primary);
            background: var(--primary-light); border-radius: 0.5rem;
            transition: all 0.15s;
        }
        .card-link:hover { background: var(--primary); color: white; }
        .card-footer {
            padding: 0.875rem 1.125rem;
            border-top: 1px solid var(--border);
            display: flex; gap: 0.5rem;
            background: #f8fdf9;
        }
        .card-footer .btn { flex: 1; justify-content: center; font-size: 0.75rem; padding: 0.45rem 0.5rem; }

        /* ── List View ── */
        .list-table {
            background: var(--bg-card);
            border-radius: 1rem;
            box-shadow: var(--shadow-md);
            overflow: hidden;
            width: 100%;
        }
        .list-table table { width: 100%; border-collapse: collapse; }
        .list-table thead th {
            padding: 0.875rem 1rem;
            text-align: left; font-size: 0.75rem; font-weight: 700;
            text-transform: uppercase; letter-spacing: 0.05em;
            color: var(--text-muted);
            background: #f8fafc;
            border-bottom: 1px solid var(--border);
        }
        .list-table thead th:first-child { padding-left: 1.25rem; width: 44px; }
        .list-table thead th:last-child  { text-align: right; padding-right: 1.25rem; }
        .list-table tbody tr {
            border-bottom: 1px solid var(--border);
            transition: background 0.12s;
        }
        .list-table tbody tr:last-child { border-bottom: none; }
        .list-table tbody tr:hover { background: #f0fdf4; }
        .list-table tbody tr.selected { background: #dcfce7; }
        .list-table td {
            padding: 0.875rem 1rem;
            font-size: 0.8125rem; vertical-align: middle;
        }
        .list-table td:first-child { padding-left: 1.25rem; }
        .list-table td:last-child  { text-align: right; padding-right: 1.25rem; }
        .list-table td input[type="checkbox"] { width: 16px; height: 16px; cursor: pointer; accent-color: var(--primary); }

        .list-group-info { display: flex; align-items: center; gap: 0.75rem; }
        .list-thumb {
            width: 44px; height: 44px; border-radius: 0.5rem; object-fit: cover; flex-shrink: 0;
            background: #f1f5f9;
        }
        .list-name { font-weight: 600; color: var(--text-main); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 240px; }
        .list-desc { font-size: 0.75rem; color: var(--text-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 240px; }
        .list-actions { display: flex; gap: 0.4rem; justify-content: flex-end; }
        .cat-pill {
            display: inline-block; padding: 0.2rem 0.6rem;
            background: var(--primary-light); color: var(--primary-hover);
            border-radius: 9999px; font-size: 0.7rem; font-weight: 700; text-transform: uppercase;
        }

        /* ── States ── */
        .loading-container { text-align: center; padding: 5rem 2rem; }
        .spinner {
            width: 36px; height: 36px;
            border: 3px solid var(--border);
            border-top-color: var(--primary);
            border-radius: 50%;
            animation: spin 0.75s linear infinite;
            margin: 0 auto 1rem;
        }
        @keyframes spin { to { transform: rotate(360deg); } }
        .empty-state {
            text-align: center; padding: 5rem 2rem;
            background: var(--bg-card);
            border-radius: 1rem;
            border: 2px dashed var(--border);
        }
        .empty-state h3 { margin-bottom: 0.5rem; }

        /* ── Toast ── */
        .toast-container { position: fixed; bottom: 1.5rem; right: 1.5rem; z-index: 9999; display: flex; flex-direction: column; gap: 0.5rem; }
        .toast {
            display: flex; align-items: center; gap: 0.75rem;
            padding: 0.875rem 1.25rem;
            border-radius: 0.75rem;
            font-size: 0.875rem; font-weight: 500;
            box-shadow: var(--shadow-lg);
            animation: toastIn 0.25s ease;
            min-width: 260px;
        }
        .toast-success { background: #ecfdf5; border: 1px solid #6ee7b7; color: #065f46; }
        .toast-error   { background: #fef2f2; border: 1px solid #fca5a5; color: #991b1b; }
        .toast-info    { background: #eff6ff; border: 1px solid #93c5fd; color: #1e40af; }
        @keyframes toastIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

        /* ── Cleanup / Deleted Tab ── */
        .btn-cleanup {
            background: linear-gradient(135deg, #7c3aed, #6d28d9);
            color: #fff;
            border: none;
        }
        .btn-cleanup:hover:not(:disabled) {
            background: linear-gradient(135deg, #6d28d9, #5b21b6);
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(109,40,217,.4);
        }
        .btn-cleanup.running { opacity: 0.7; cursor: not-allowed; }

        .cleanup-summary {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
            gap: 1rem;
            margin-bottom: 1.5rem;
        }
        .summary-card {
            background: var(--bg-card);
            border-radius: 1rem;
            padding: 1.25rem 1.5rem;
            box-shadow: var(--shadow-md);
            text-align: center;
            border: 1px solid var(--border);
        }
        .summary-card.danger  { border-color: #fca5a5; background: #fef2f2; }
        .summary-card.success { border-color: #6ee7b7; background: #ecfdf5; }
        .summary-card.purple  { border-color: var(--deleted-border); background: var(--deleted-light); }
        .summary-card .sc-num {
            font-size: 2rem; font-weight: 800; line-height: 1;
            margin-bottom: 0.25rem;
        }
        .summary-card.danger  .sc-num { color: var(--danger); }
        .summary-card.success .sc-num { color: var(--success); }
        .summary-card.purple  .sc-num { color: var(--deleted); }
        .summary-card .sc-label { font-size: 0.8125rem; font-weight: 600; color: var(--text-muted); }

        .deleted-list {
            background: var(--bg-card);
            border-radius: 1rem;
            box-shadow: var(--shadow-md);
            overflow: hidden;
        }
        .deleted-list-header {
            padding: 1rem 1.25rem;
            border-bottom: 1px solid var(--border);
            font-weight: 700; font-size: 0.875rem;
            display: flex; align-items: center; gap: 0.5rem;
            color: var(--deleted);
            background: var(--deleted-light);
        }
        .deleted-item {
            display: flex; align-items: center; gap: 1rem;
            padding: 0.875rem 1.25rem;
            border-bottom: 1px solid var(--border);
            transition: background 0.12s;
        }
        .deleted-item:last-child { border-bottom: none; }
        .deleted-item:hover { background: var(--deleted-light); }
        .deleted-thumb {
            width: 44px; height: 44px;
            border-radius: 0.5rem; object-fit: cover;
            flex-shrink: 0; background: #f1f5f9;
            border: 2px solid var(--deleted-border);
            filter: grayscale(60%);
        }
        .deleted-info { flex: 1; min-width: 0; }
        .deleted-name { font-weight: 700; font-size: 0.875rem; color: var(--text-main); }
        .deleted-img-url {
            font-size: 0.72rem; color: var(--danger);
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
            max-width: 420px;
        }
        .deleted-badge {
            display: inline-flex; align-items: center; gap: 0.3rem;
            padding: 0.2rem 0.6rem;
            background: #fee2e2; color: var(--danger);
            border-radius: 9999px; font-size: 0.7rem; font-weight: 700;
            white-space: nowrap; flex-shrink: 0;
        }
        .nav-tab.deleted-tab.active {
            background: linear-gradient(135deg, #7c3aed, #6d28d9);
            box-shadow: 0 2px 8px rgba(109,40,217,.35);
        }
        .cleanup-info-banner {
            display: flex; align-items: center; gap: 0.75rem;
            padding: 0.875rem 1.25rem;
            background: var(--deleted-light);
            border: 1px solid var(--deleted-border);
            border-radius: 0.75rem;
            margin-bottom: 1.25rem;
            font-size: 0.8125rem; color: var(--deleted);
        }
        .cleanup-info-banner strong { font-weight: 700; }

        @media (max-width: 768px) {
            .layout { padding: 1rem; }
            .header { flex-direction: column; gap: 1rem; text-align: center; }
            .header-actions { flex-wrap: wrap; justify-content: center; }
            .nav-container { flex-direction: column; }
            .card-grid { grid-template-columns: 1fr; }
            .toolbar { flex-wrap: wrap; }
            .bulk-bar { flex-wrap: wrap; }
        }
    </style>
</head>

<body>
    <div class="layout">
        <!-- Header -->
        <header class="header">
            <div class="header-brand">
                <div class="logo">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/>
                    </svg>
                </div>
                <div class="header-title">
                    <h1>WhatsApp Admin</h1>
                    <p>Manage and moderate WhatsApp group submissions</p>
                </div>
            </div>
            <div class="header-actions">
                <div class="view-toggle">
                    <button class="view-btn" id="view-card" onclick="setView('card')" title="Card View">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
                            <rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/>
                        </svg>
                    </button>
                    <button class="view-btn active" id="view-list" onclick="setView('list')" title="List View">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/>
                            <line x1="8" y1="18" x2="21" y2="18"/>
                            <circle cx="3" cy="6" r="1" fill="currentColor"/><circle cx="3" cy="12" r="1" fill="currentColor"/><circle cx="3" cy="18" r="1" fill="currentColor"/>
                        </svg>
                    </button>
                </div>
                <button class="btn btn-outline" onclick="refreshCurrentTab()">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                    </svg>
                    Refresh
                </button>
                <button class="btn btn-cleanup" id="cleanup-btn" onclick="openDeletedTab(event)" title="Delete pending groups with broken images">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <polyline points="3 6 5 6 21 6"/>
                        <path d="M19 6l-1 14H6L5 6"/>
                        <path d="M10 11v6M14 11v6"/>
                        <path d="M9 6V4h6v2"/>
                    </svg>
                    Cleanup
                </button>
            </div>
        </header>

        <!-- Nav Tabs -->
        <nav class="nav-container">
            <button class="nav-tab active" id="tab-pending" onclick="switchTab('pending', 0, event)">
                ⏳ Pending <span class="badge" id="pending-count">0</span>
            </button>
            <button class="nav-tab" id="tab-approved" onclick="switchTab('approved', 1, event)">
                ✅ Approved <span class="badge" id="approved-count">0</span>
            </button>
            <button class="nav-tab" id="tab-rejected" onclick="switchTab('rejected', 2, event)">
                ❌ Rejected <span class="badge" id="rejected-count">0</span>
            </button>
            <button class="nav-tab deleted-tab" id="tab-deleted" onclick="openDeletedTab(event)">
                🗑️ Deleted <span class="badge" id="deleted-count">—</span>
            </button>
        </nav>

        <!-- Bulk Action Bar -->
        <div class="bulk-bar" id="bulk-bar">
            <span class="selected-label" id="selected-label">0 selected</span>
            <button class="bulk-btn bulk-btn-approve" onclick="bulkAction(1)">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                Approve All
            </button>
            <button class="bulk-btn bulk-btn-reject" onclick="bulkAction(2)">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                Reject All
            </button>
            <button class="bulk-btn bulk-btn-pend" onclick="bulkAction(0)">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                Move to Pending
            </button>
            <button class="bulk-btn bulk-btn-delete-forever" id="bulk-delete-forever-btn"
                onclick="bulkPermanentDelete()" style="display:none"
                title="Permanently delete all selected rejected groups">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polyline points="3 6 5 6 21 6"/>
                    <path d="M19 6l-1 14H6L5 6"/>
                    <path d="M10 11v6M14 11v6"/>
                    <path d="M9 6V4h6v2"/>
                </svg>
                Delete Forever
            </button>
            <button class="bulk-btn bulk-btn-clear" onclick="clearSelection()">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                Clear
            </button>
        </div>

        <!-- Toolbar -->
        <div class="toolbar" id="toolbar" style="display:none;">
            <div class="left">
                <label class="select-all-wrap" for="select-all-cb">
                    <input type="checkbox" id="select-all-cb" onchange="toggleSelectAll(this.checked)">
                    Select All
                </label>
                <span class="count-label" id="count-label"></span>
            </div>
        </div>

        <!-- Content -->
        <main id="content-area">
            <div class="loading-container">
                <div class="spinner"></div>
                <p>Initializing dashboard…</p>
            </div>
        </main>
    </div>

    <!-- Toast Container -->
    <div class="toast-container" id="toast-container"></div>

    <script>
        let currentStatus = 0;
        let currentTabName = 'pending';
        let groupsData = { pending: [], approved: [], rejected: [], deleted: [] };
        let selectedIds = new Set();
        let currentView = 'list'; // 'card' | 'list'
        let cleanupRunning = false;
        let lastCleanupResult = null; // cache last cleanup result

        window.onload = () => loadGroups(0, 'pending');

        /* ── View Toggle ── */
        function setView(v) {
            currentView = v;
            document.getElementById('view-card').classList.toggle('active', v === 'card');
            document.getElementById('view-list').classList.toggle('active', v === 'list');
            renderGroups(groupsData[currentTabName], currentStatus);
        }

        /* ── Tab ── */
        function switchTab(tabName, status, event) {
            currentStatus = status;
            currentTabName = tabName;
            clearSelection();
            document.querySelectorAll('.nav-tab').forEach(t => t.classList.remove('active'));
            event.currentTarget.classList.add('active');
            // Hide bulk bar for non-group tabs
            if (tabName === 'deleted') return; // handled by openDeletedTab
            loadGroups(status, tabName);
        }

        /* ── Load ── */
        async function loadGroups(status, tabName) {
            const contentArea = document.getElementById('content-area');
            document.getElementById('toolbar').style.display = 'none';
            contentArea.innerHTML = `
                <div class="loading-container">
                    <div class="spinner"></div>
                    <p>Fetching ${tabName} groups…</p>
                </div>`;

            try {
                const response = await fetch(`/wa/admin/getGroups?status=${status}`);
                if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
                const result = await response.json();
                const data = result.data || result || [];
                groupsData[tabName] = data;
                updateTabCount(tabName, data.length);
                renderGroups(data, status);
            } catch (error) {
                console.error('Error loading groups:', error);
                contentArea.innerHTML = `
                    <div class="empty-state">
                        <h3 style="color:var(--danger)">Connection Error</h3>
                        <p>${escapeHtml(error.message)}</p>
                        <button class="btn btn-primary" style="margin-top:1rem" onclick="refreshCurrentTab()">Try Again</button>
                    </div>`;
            }
        }

        function updateTabCount(tabName, count) {
            const badge = document.getElementById(`${tabName}-count`);
            if (badge) badge.textContent = count;
        }

        function refreshCurrentTab() { clearSelection(); loadGroups(currentStatus, currentTabName); }

        /* ── Render ── */
        function renderGroups(groups, status) {
            const contentArea = document.getElementById('content-area');
            const toolbar = document.getElementById('toolbar');

            if (!groups || groups.length === 0) {
                toolbar.style.display = 'none';
                contentArea.innerHTML = `
                    <div class="empty-state">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" style="color:var(--text-muted);margin-bottom:1rem">
                            <path d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/>
                        </svg>
                        <h3>No Groups Found</h3>
                        <p>There are no items in this category at the moment.</p>
                    </div>`;
                return;
            }

            toolbar.style.display = 'flex';
            document.getElementById('count-label').textContent = `${groups.length} group${groups.length !== 1 ? 's' : ''}`;

            if (currentView === 'list') {
                renderListView(groups, status, contentArea);
            } else {
                renderCardView(groups, status, contentArea);
            }
            syncSelectAll();
        }

        /* ── Card View ── */
        function renderCardView(groups, status, container) {
            container.innerHTML = `
                <div class="card-grid">
                    ${groups.map(g => `
                        <div class="card ${selectedIds.has(g._id) ? 'selected' : ''}" id="group-${g._id}">
                            <div class="card-checkbox-wrap">
                                <input type="checkbox" ${selectedIds.has(g._id) ? 'checked' : ''}
                                    onchange="toggleItem('${g._id}', this.checked)"
                                    onclick="event.stopPropagation()" title="Select this group">
                            </div>
                            <div class="card-image-wrapper">
                                <img src="${g.image || 'https://images.unsplash.com/photo-1614680376593-902f74cf0d41?w=400&h=200&fit=crop'}"
                                     alt="${escapeHtml(g.name)}" class="card-image"
                                     onerror="this.src='https://via.placeholder.com/400x160?text=WA+Group'">
                                <span class="card-category">${escapeHtml(g.category || 'general')}</span>
                            </div>
                            <div class="card-body">
                                <h3 class="card-title">${escapeHtml(g.name)}</h3>
                                <p class="card-description">${escapeHtml(g.description || 'No description provided.')}</p>
                                <div class="card-meta">
                                    <div class="meta-item">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                        ${g.views || 0} views
                                    </div>
                                    <div class="meta-item">
                                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                                        ${new Date(g.createdAt).toLocaleDateString()}
                                    </div>
                                </div>
                                <a href="${g.url}" target="_blank" class="card-link">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M10 13a5 5 0 007.54.54l3-3a5 5 0 00-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 00-7.54-.54l-3 3a5 5 0 007.07 7.07l1.71-1.71"/></svg>
                                    View on WhatsApp
                                </a>
                            </div>
                            <div class="card-footer">
                                ${status !== 1 ? `<button class="btn btn-success" onclick="updateStatus('${g._id}', 1)">✓ Approve</button>` : ''}
                                ${status !== 2 ? `<button class="btn btn-danger"  onclick="updateStatus('${g._id}', 2)">✕ Reject</button>` : ''}
                                ${status !== 0 ? `<button class="btn btn-warning" onclick="updateStatus('${g._id}', 0)">⏳ Pend</button>` : ''}
                                ${status === 2 ? `<button class="btn btn-delete-forever" onclick="permanentDelete('${g._id}', '${escapeHtml(g.name).replace(/'/g, "\\'")}')"
                                    title="Permanently delete this group">
                                    <svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5'><polyline points='3 6 5 6 21 6'/><path d='M19 6l-1 14H6L5 6'/><path d='M10 11v6M14 11v6'/></svg>
                                    Delete Forever
                                </button>` : ''}
                            </div>
                        </div>`).join('')}
                </div>`;
        }

        /* ── List View ── */
        function renderListView(groups, status, container) {
            container.innerHTML = `
                <div class="list-table">
                    <table>
                        <thead>
                            <tr>
                                <th><input type="checkbox" id="th-select-all" onchange="toggleSelectAll(this.checked)" ${selectedIds.size === groups.length && groups.length > 0 ? 'checked' : ''}></th>
                                <th>Group</th>
                                <th>Category</th>
                                <th>Views</th>
                                <th>Submitted</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${groups.map(g => `
                                <tr id="row-${g._id}" class="${selectedIds.has(g._id) ? 'selected' : ''}">
                                    <td><input type="checkbox" ${selectedIds.has(g._id) ? 'checked' : ''} onchange="toggleItem('${g._id}', this.checked)"></td>
                                    <td>
                                        <div class="list-group-info">
                                            <img src="${g.image || 'https://via.placeholder.com/44?text=WA'}"
                                                 class="list-thumb"
                                                 onerror="this.src='https://via.placeholder.com/44?text=WA'" alt="">
                                            <div>
                                                <div class="list-name">${escapeHtml(g.name)}</div>
                                                <div class="list-desc">${escapeHtml(g.description || '—')}</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td><span class="cat-pill">${escapeHtml(g.category || 'general')}</span></td>
                                    <td>${g.views || 0}</td>
                                    <td>${new Date(g.createdAt).toLocaleDateString()}</td>
                                    <td>
                                        <div class="list-actions">
                                            <a href="${g.url}" target="_blank" class="btn btn-ghost btn-sm" title="View on WhatsApp">🔗</a>
                                            ${status !== 1 ? `<button class="btn btn-success btn-sm" onclick="updateStatus('${g._id}', 1)" title="Approve">✓</button>` : ''}
                                            ${status !== 2 ? `<button class="btn btn-danger btn-sm"  onclick="updateStatus('${g._id}', 2)" title="Reject">✕</button>` : ''}
                                            ${status !== 0 ? `<button class="btn btn-warning btn-sm" onclick="updateStatus('${g._id}', 0)" title="Move to Pending">⏳</button>` : ''}
                                            ${status === 2 ? `<button class="btn btn-delete-forever btn-sm" onclick="permanentDelete('${g._id}', '${escapeHtml(g.name).replace(/'/g, "\\'")}')"
                                                title="Permanently delete">
                                                <svg width='11' height='11' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.5'><polyline points='3 6 5 6 21 6'/><path d='M19 6l-1 14H6L5 6'/></svg>
                                            </button>` : ''}
                                        </div>
                                    </td>
                                </tr>`).join('')}
                        </tbody>
                    </table>
                </div>`;
        }

        /* ── Selection Logic ── */
        function toggleItem(id, checked) {
            if (checked) selectedIds.add(id);
            else selectedIds.delete(id);
            const card = document.getElementById(`group-${id}`);
            const row  = document.getElementById(`row-${id}`);
            if (card) card.classList.toggle('selected', checked);
            if (row)  row.classList.toggle('selected', checked);
            updateBulkBar();
            syncSelectAll();
        }

        function toggleSelectAll(checked) {
            const groups = groupsData[currentTabName];
            groups.forEach(g => {
                if (checked) selectedIds.add(g._id);
                else selectedIds.delete(g._id);
                const card = document.getElementById(`group-${g._id}`);
                const row  = document.getElementById(`row-${g._id}`);
                if (card) {
                    const cb = card.querySelector('input[type="checkbox"]');
                    if (cb) cb.checked = checked;
                    card.classList.toggle('selected', checked);
                }
                if (row) {
                    const cb = row.querySelector('input[type="checkbox"]');
                    if (cb) cb.checked = checked;
                    row.classList.toggle('selected', checked);
                }
            });
            updateBulkBar();
            const thCb = document.getElementById('th-select-all');
            if (thCb) thCb.checked = checked;
            const mainCb = document.getElementById('select-all-cb');
            if (mainCb) mainCb.checked = checked;
        }

        function syncSelectAll() {
            const groups = groupsData[currentTabName];
            const allSelected = groups.length > 0 && groups.every(g => selectedIds.has(g._id));
            const mainCb = document.getElementById('select-all-cb');
            if (mainCb) mainCb.checked = allSelected;
            const thCb = document.getElementById('th-select-all');
            if (thCb) thCb.checked = allSelected;
        }

        function clearSelection() {
            selectedIds.clear();
            document.querySelectorAll('input[type="checkbox"]').forEach(cb => cb.checked = false);
            document.querySelectorAll('.card.selected, .list-table tr.selected').forEach(el => el.classList.remove('selected'));
            updateBulkBar();
        }

        function updateBulkBar() {
            const bar = document.getElementById('bulk-bar');
            const label = document.getElementById('selected-label');
            const deleteForeverBtn = document.getElementById('bulk-delete-forever-btn');
            const n = selectedIds.size;
            if (n > 0) {
                bar.classList.add('visible');
                label.textContent = `${n} item${n !== 1 ? 's' : ''} selected`;
            } else {
                bar.classList.remove('visible');
            }
            // Show "Delete Forever" only on the rejected tab
            if (deleteForeverBtn) {
                deleteForeverBtn.style.display = (currentTabName === 'rejected' && n > 0) ? 'inline-flex' : 'none';
            }
        }

        /* ── Single Status Update ── */
        async function updateStatus(groupId, newStatus) {
            const card = document.getElementById(`group-${groupId}`);
            const row  = document.getElementById(`row-${groupId}`);
            if (card) card.style.opacity = '0.5';
            if (row)  row.style.opacity  = '0.5';

            try {
                const response = await fetch('/wa/admin/updateStatus', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ groupId, status: newStatus })
                });
                if (!response.ok) throw new Error('Update failed');
                if (card) { card.style.transform = 'scale(0.95)'; card.style.opacity = '0'; }
                if (row)  { row.style.opacity  = '0'; }
                setTimeout(() => refreshCurrentTab(), 280);
                showToast('Status updated successfully', 'success');
            } catch (error) {
                console.error('Update status error:', error);
                showToast('Failed to update status', 'error');
                if (card) card.style.opacity = '1';
                if (row)  row.style.opacity  = '1';
            }
        }

        /* ── Bulk Status Update ── */
        async function bulkAction(newStatus) {
            if (selectedIds.size === 0) return;
            const groupIds = Array.from(selectedIds);
            const actionName = newStatus === 1 ? 'approve' : newStatus === 2 ? 'reject' : 'pend';
            showToast(`${actionName.charAt(0).toUpperCase() + actionName.slice(1)}ing ${groupIds.length} item(s)…`, 'info');

            try {
                const response = await fetch('/wa/admin/bulkUpdateStatus', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ groupIds, status: newStatus })
                });
                const result = await response.json();
                if (!response.ok) throw new Error(result.message || 'Bulk update failed');
                showToast(result.message || 'Bulk update successful', 'success');
                clearSelection();
                refreshCurrentTab();
            } catch (error) {
                console.error('Bulk action error:', error);
                showToast(error.message || 'Bulk action failed', 'error');
            }
        }

        /* ── Bulk Permanent Delete ── */
        async function bulkPermanentDelete() {
            const n = selectedIds.size;
            if (n === 0) return;
            const confirmed = confirm(`⚠️ PERMANENT BULK DELETE\n\nYou are about to permanently delete ${n} group${n !== 1 ? 's' : ''}.\n\nThis action CANNOT be undone!`);
            if (!confirmed) return;

            const groupIds = Array.from(selectedIds);
            showToast(`Permanently deleting ${n} group${n !== 1 ? 's' : ''}…`, 'info');

            groupIds.forEach(id => {
                const card = document.getElementById(`group-${id}`);
                const row  = document.getElementById(`row-${id}`);
                if (card) { card.style.opacity = '0.4'; card.style.pointerEvents = 'none'; }
                if (row)  { row.style.opacity  = '0.4'; row.style.pointerEvents  = 'none'; }
            });

            try {
                const response = await fetch('/wa/admin/bulkPermanentDelete', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ groupIds })
                });
                const result = await response.json();
                if (!response.ok) throw new Error(result.message || 'Bulk delete failed');

                groupIds.forEach(id => {
                    const card = document.getElementById(`group-${id}`);
                    const row  = document.getElementById(`row-${id}`);
                    if (card) { card.style.transform = 'scale(0.9)'; card.style.opacity = '0'; card.style.transition = 'all 0.25s'; }
                    if (row)  { row.style.opacity = '0'; row.style.transition = 'opacity 0.25s'; }
                });

                groupsData[currentTabName] = groupsData[currentTabName].filter(g => !selectedIds.has(g._id));
                selectedIds.clear();
                updateTabCount(currentTabName, groupsData[currentTabName].length);

                setTimeout(() => {
                    groupIds.forEach(id => {
                        const el1 = document.getElementById(`group-${id}`);
                        const el2 = document.getElementById(`row-${id}`);
                        if (el1) el1.remove();
                        if (el2) el2.remove();
                    });
                    updateBulkBar();
                    document.getElementById('count-label').textContent =
                        `${groupsData[currentTabName].length} group${groupsData[currentTabName].length !== 1 ? 's' : ''}`;
                    if (groupsData[currentTabName].length === 0) refreshCurrentTab();
                }, 300);

                showToast(result.message || `${n} group(s) permanently deleted`, 'success');
            } catch (error) {
                console.error('[WA BulkPermanentDelete]', error);
                showToast('Bulk delete failed: ' + error.message, 'error');
                groupIds.forEach(id => {
                    const card = document.getElementById(`group-${id}`);
                    const row  = document.getElementById(`row-${id}`);
                    if (card) { card.style.opacity = '1'; card.style.pointerEvents = ''; }
                    if (row)  { row.style.opacity  = '1'; row.style.pointerEvents  = ''; }
                });
            }
        }

        /* ── Permanent Delete ── */
        async function permanentDelete(groupId, groupName) {
            const confirmed = confirm(`⚠️ PERMANENT DELETE\n\nAre you sure you want to permanently delete:\n"${groupName}"\n\nThis action CANNOT be undone!`);
            if (!confirmed) return;

            const card = document.getElementById(`group-${groupId}`);
            const row  = document.getElementById(`row-${groupId}`);
            if (card) { card.style.opacity = '0.4'; card.style.pointerEvents = 'none'; }
            if (row)  { row.style.opacity  = '0.4'; row.style.pointerEvents  = 'none'; }

            try {
                const response = await fetch(`/wa/admin/permanentDelete/${groupId}`, {
                    method: 'DELETE',
                    headers: { 'Content-Type': 'application/json' }
                });
                const result = await response.json();
                if (!response.ok) throw new Error(result.message || 'Delete failed');

                // Animate out then remove from local data
                if (card) { card.style.transform = 'scale(0.9)'; card.style.opacity = '0'; card.style.transition = 'all 0.25s'; }
                if (row)  { row.style.opacity = '0'; row.style.transition = 'opacity 0.25s'; }

                // Remove from local groupsData and refresh counts
                groupsData[currentTabName] = groupsData[currentTabName].filter(g => g._id !== groupId);
                updateTabCount(currentTabName, groupsData[currentTabName].length);
                document.getElementById('count-label').textContent =
                    `${groupsData[currentTabName].length} group${groupsData[currentTabName].length !== 1 ? 's' : ''}`;

                setTimeout(() => {
                    if (card) card.remove();
                    if (row)  row.remove();
                    if (groupsData[currentTabName].length === 0) refreshCurrentTab();
                }, 280);

                showToast(`"​${groupName}​" permanently deleted`, 'success');
            } catch (error) {
                console.error('[WA PermanentDelete]', error);
                showToast('Delete failed: ' + error.message, 'error');
                if (card) { card.style.opacity = '1'; card.style.pointerEvents = ''; }
                if (row)  { row.style.opacity  = '1'; row.style.pointerEvents  = ''; }
            }
        }

        /* ══════════════════════════════════════════
           CLEANUP / DELETED TAB
        ══════════════════════════════════════════ */

        /**
         * openDeletedTab — switches UI to Deleted tab and runs cleanup if needed
         */
        async function openDeletedTab(event) {
            if (cleanupRunning) { showToast('Cleanup is already running…', 'info'); return; }

            // Update tab UI
            currentTabName = 'deleted';
            clearSelection();
            document.getElementById('toolbar').style.display = 'none';
            document.querySelectorAll('.nav-tab').forEach(t => t.classList.remove('active'));
            const deletedTab = document.getElementById('tab-deleted');
            if (deletedTab) deletedTab.classList.add('active');

            const contentArea = document.getElementById('content-area');

            // If we already have a result cached, just show it
            if (lastCleanupResult) {
                renderDeletedView(lastCleanupResult, contentArea);
                return;
            }

            // Run cleanup
            cleanupRunning = true;
            const cleanupBtn = document.getElementById('cleanup-btn');
            if (cleanupBtn) { cleanupBtn.classList.add('running'); cleanupBtn.disabled = true; }

            contentArea.innerHTML = `
                <div class="loading-container">
                    <div class="spinner" style="border-top-color:#7c3aed"></div>
                    <p style="color:#7c3aed;font-weight:600">Running image cleanup on pending groups…</p>
                    <p style="font-size:0.8125rem;color:var(--text-muted);margin-top:0.5rem">Checking each group's image URL. This may take a moment.</p>
                </div>`;

            try {
                const response = await fetch('/wa/admin/cleanupBrokenImages');
                const result = await response.json();
                if (!response.ok) throw new Error(result.message || 'Cleanup failed');

                lastCleanupResult = result.data;
                groupsData.deleted = result.data.deletedGroups || [];
                document.getElementById('deleted-count').textContent = result.data.deleted || 0;
                renderDeletedView(result.data, contentArea);
                if (result.data.deleted > 0) {
                    showToast(`${result.data.deleted} group(s) permanently deleted`, 'success');
                    // refresh pending count
                    loadGroupCountSilently(0, 'pending');
                } else {
                    showToast('Cleanup complete — no broken images found', 'info');
                }
            } catch (error) {
                console.error('[Cleanup] Error:', error);
                contentArea.innerHTML = `
                    <div class="empty-state">
                        <h3 style="color:var(--danger)">Cleanup Failed</h3>
                        <p>${escapeHtml(error.message)}</p>
                        <button class="btn btn-cleanup" style="margin-top:1rem" onclick="lastCleanupResult=null;openDeletedTab(event)">Retry</button>
                    </div>`;
                showToast('Cleanup failed: ' + error.message, 'error');
            } finally {
                cleanupRunning = false;
                if (cleanupBtn) { cleanupBtn.classList.remove('running'); cleanupBtn.disabled = false; }
            }
        }

        /** Silently reload a tab's count badge without changing the view */
        async function loadGroupCountSilently(status, tabName) {
            try {
                const r = await fetch(`/wa/admin/getGroups?status=${status}`);
                const result = await r.json();
                const data = result.data || [];
                groupsData[tabName] = data;
                updateTabCount(tabName, data.length);
            } catch (_) {}
        }

        /**
         * Render the deleted tab result view
         */
        function renderDeletedView(data, container) {
            const { checked = 0, deleted = 0, deletedGroups = [] } = data;
            const safe = checked - deleted;

            const deletedRows = deletedGroups.length === 0
                ? `<div style="padding:3rem 2rem;text-align:center;color:var(--text-muted)">
                        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" style="margin-bottom:0.75rem;color:#22c55e">
                            <path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="10"/>
                        </svg>
                        <p style="font-weight:600;color:#15803d">All images are intact — nothing was deleted.</p>
                   </div>`
                : deletedGroups.map(g => `
                    <div class="deleted-item">
                        <img src="${escapeHtml(g.image || '')}"
                             class="deleted-thumb"
                             onerror="this.src='https://via.placeholder.com/44?text=404'" alt="">
                        <div class="deleted-info">
                            <div class="deleted-name">${escapeHtml(g.name || 'Unknown Group')}</div>
                            <div class="deleted-img-url" title="${escapeHtml(g.image || '')}">
                                🔗 ${escapeHtml(g.image || 'No image URL')}
                            </div>
                        </div>
                        <span class="deleted-badge">
                            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M18 6L6 18M6 6l12 12"/></svg>
                            Image not found
                        </span>
                    </div>`).join('');

            container.innerHTML = `
                <div class="cleanup-info-banner">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                    <span>Cleanup scanned <strong>${checked}</strong> pending group(s) and permanently deleted <strong>${deleted}</strong> with broken/missing images.
                    &nbsp;<button style="font-size:0.75rem;font-weight:600;color:var(--deleted);background:none;border:none;cursor:pointer;text-decoration:underline" onclick="lastCleanupResult=null;openDeletedTab(event)">Run again ↺</button></span>
                </div>

                <div class="cleanup-summary">
                    <div class="summary-card purple">
                        <div class="sc-num">${checked}</div>
                        <div class="sc-label">Groups Checked</div>
                    </div>
                    <div class="summary-card danger">
                        <div class="sc-num">${deleted}</div>
                        <div class="sc-label">Permanently Deleted</div>
                    </div>
                    <div class="summary-card success">
                        <div class="sc-num">${safe}</div>
                        <div class="sc-label">Images OK</div>
                    </div>
                </div>

                ${ deleted > 0 ? `
                <div class="deleted-list">
                    <div class="deleted-list-header">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <polyline points="3 6 5 6 21 6"/>
                            <path d="M19 6l-1 14H6L5 6"/>
                            <path d="M10 11v6M14 11v6"/>
                        </svg>
                        Permanently Deleted Groups (${deleted})
                    </div>
                    ${deletedRows}
                </div>` : deletedRows }
            `;
        }

        /* ── Toast ── */
        function showToast(message, type = 'info') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = `toast toast-${type}`;
            const icons = { success: '✅', error: '❌', info: 'ℹ️' };
            toast.innerHTML = `<span>${icons[type] || 'ℹ️'}</span><span>${escapeHtml(message)}</span>`;
            container.appendChild(toast);
            setTimeout(() => { toast.style.opacity = '0'; toast.style.transition = 'opacity 0.3s'; setTimeout(() => toast.remove(), 300); }, 3500);
        }

        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }
    </script>
</body>

</html>